                                    <StackPanel>
                                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="最近一轮 · 原始输入 (raw)" Foreground="{StaticResource HudMuted}" FontSize="11.5" /><TextBlock Grid.Column="1" Text="{Binding RecentUsage.RawInput, StringFormat={}{0:N0}}" FontFamily="Cascadia Mono, Consolas" FontSize="12" /></Grid>
                                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="缓存输入 (raw)" Foreground="{StaticResource HudMuted}" FontSize="11.5" /><TextBlock Grid.Column="1" Text="{Binding RecentUsage.CachedInput, StringFormat={}{0:N0}}" FontFamily="Cascadia Mono, Consolas" FontSize="12" /></Grid>
                                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="输出 (raw)" Foreground="{StaticResource HudMuted}" FontSize="11.5" /><TextBlock Grid.Column="1" Text="{Binding RecentUsage.Output, StringFormat={}{0:N0}}" FontFamily="Cascadia Mono, Consolas" FontSize="12" /></Grid>
                                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="推理 (raw)" Foreground="{StaticResource HudMuted}" FontSize="11.5" /><TextBlock Grid.Column="1" Text="{Binding RecentUsage.Reasoning, StringFormat={}{0:N0}}" FontFamily="Cascadia Mono, Consolas" FontSize="12" /></Grid>
