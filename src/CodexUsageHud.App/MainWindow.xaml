                                <StackPanel><TextBlock Text="{Binding QuotaSourceText}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="{Binding FreshnessText}" Foreground="{StaticResource HudMuted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" /><TextBlock x:Name="EventsTextBlock" Text="{Binding EventsText}" Foreground="{StaticResource HudMuted}" FontSize="10.5" Margin="0,12,0,0" TextWrapping="Wrap" /></StackPanel>
                            </Border>
