                                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="推理" Foreground="{StaticResource HudMuted}" FontSize="11.5" /><TextBlock Grid.Column="1" Text="{Binding SessionTotal.Reasoning, StringFormat={}{0:N0}}" FontFamily="Cascadia Mono, Consolas" FontSize="12" /></Grid>
