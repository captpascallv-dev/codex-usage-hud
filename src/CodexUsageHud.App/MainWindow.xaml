                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                <Button x:Name="CompactTopExpandButton" Style="{StaticResource DialButtonStyle}" Click="OnToggleExpand"
                        HorizontalContentAlignment="Stretch" ToolTip="展开完整仪表">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="1.15*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="剩余额度" Foreground="{StaticResource HudMuted}" FontSize="10" />
                            <TextBlock x:Name="CompactTopRemainingText" Text="{Binding RemainingText}" Foreground="{StaticResource HudMint}"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="27" FontWeight="SemiBold" />
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="#FF2B383A" BorderThickness="1,0,0,0" Padding="14,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="后重置" Foreground="{StaticResource HudSubtle}" FontSize="10" />
                                <TextBlock x:Name="CompactTopCountdownText" Text="{Binding CountdownCompactText}" FontFamily="Cascadia Mono, Consolas" FontSize="15" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="#FF2B383A" BorderThickness="1,0,0,0" Padding="14,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="运行中" Foreground="{StaticResource HudSubtle}" FontSize="10" />
                                <TextBlock x:Name="CompactTopRunningText" Text="{Binding RunningCountText}" FontFamily="Cascadia Mono, Consolas" FontSize="18" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" BorderBrush="#FF2B383A" BorderThickness="1,0,0,0" Padding="14,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="本机本周期" Foreground="{StaticResource HudSubtle}" FontSize="10" />
                                <TextBlock Text="{Binding CycleCompactText}" FontFamily="Cascadia Mono, Consolas" FontSize="15" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="CompactTopTopmostButton" Style="{StaticResource IconButtonStyle}" Width="34" Height="34"
                            Content="&#xE718;" ToolTip="窗口始终置顶" Click="OnToggleTopmost"
                            PreviewMouseLeftButtonDown="OnTopmostPointerDown" />
                    <Button x:Name="CompactTopMinimizeButton" Style="{StaticResource IconButtonStyle}" Width="34" Height="34"
                            Content="&#xE921;" ToolTip="最小化到托盘" Click="OnMinimizeToTray" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
