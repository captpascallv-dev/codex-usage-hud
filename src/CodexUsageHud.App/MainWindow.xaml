                <StackPanel Grid.Row="6" VerticalAlignment="Center"><TextBlock Text="{Binding CycleCompactText}" FontFamily="Cascadia Mono, Consolas" FontSize="15" HorizontalAlignment="Center" /><TextBlock Text="本机本周期" Foreground="{StaticResource HudSubtle}" FontSize="11" HorizontalAlignment="Center" /></StackPanel>
                <Button x:Name="CompactExpandButton" Grid.Row="7" Style="{StaticResource HudButton}" Height="34" Content="›" FontSize="22" ToolTip="展开完整仪表" Click="OnToggleExpand" />
