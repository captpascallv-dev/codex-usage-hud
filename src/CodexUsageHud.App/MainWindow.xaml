<Window x:Class="CodexUsageHud.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Usage HUD"
        Width="112"
        Height="330"
        MinWidth="8"
        MinHeight="8"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#FF111719"
        ShowInTaskbar="False"
        Topmost="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <Style x:Key="HudButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource HudText}" />
            <Setter Property="Background" Value="#FF20282B" />
            <Setter Property="BorderBrush" Value="{StaticResource HudLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF283437" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF527267" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF345247" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HudMint}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HudMint}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavRadio" TargetType="RadioButton">
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{StaticResource HudMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="6"
                                BorderBrush="Transparent" BorderThickness="2,0,0,0">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF20292B" />
                                <Setter Property="Foreground" Value="{StaticResource HudText}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF20322D" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HudMint}" />
                                <Setter Property="Foreground" Value="{StaticResource HudText}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HudMint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HudMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HudText}" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot" MouseLeftButtonDown="OnDrag">
        <Border x:Name="ExpandedShell" Visibility="Collapsed" Background="#FF111719"
                BorderBrush="#FF39534A" BorderThickness="1" CornerRadius="13">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="38" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE74C;" FontFamily="{StaticResource HudIconFont}" FontSize="18"
                                   Foreground="{StaticResource HudMint}" Margin="0,0,9,0" />
                        <TextBlock Text="Codex Usage HUD" FontSize="15" FontWeight="SemiBold" />
                        <Border Background="#FF20322D" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                            <TextBlock Text="V2" Foreground="{StaticResource HudMint}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        <Border Background="#FF20322D" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                            <TextBlock Text="1.0.4" Foreground="{StaticResource HudMint}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RefreshButton" Style="{StaticResource IconButtonStyle}" Width="38" Height="38"
                                Content="&#xE72C;" ToolTip="刷新额度与本地索引" Click="OnRefresh" />
                        <Button x:Name="PanelSettingsButton" Style="{StaticResource IconButtonStyle}" Width="38" Height="38"
                                Content="&#xE713;" ToolTip="设置" Click="OnSettings" />
                        <Button x:Name="FullscreenButton" Style="{StaticResource IconButtonStyle}" Width="38" Height="38"
                                Content="&#xE740;" ToolTip="全屏显示" Click="OnToggleFullscreen" />
                        <Button x:Name="CollapseButton" Style="{StaticResource IconButtonStyle}" Width="38" Height="38"
                                Content="&#xE76B;" ToolTip="收起为靠边仪表" Click="OnToggleExpand" />
                        <Button x:Name="PanelTopmostButton" Style="{StaticResource IconButtonStyle}" Width="38" Height="38"
                                Content="&#xE718;" ToolTip="窗口始终置顶" Click="OnToggleTopmost"
                                PreviewMouseLeftButtonDown="OnTopmostPointerDown" />
                        <Button Style="{StaticResource IconButtonStyle}" Width="38" Height="38"
                                Content="&#xE921;" ToolTip="最小化到系统托盘" Click="OnMinimizeToTray" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="14,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="158" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition x:Name="DetailColumn" Width="330" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FF0E1416" BorderBrush="#FF263234"
                            BorderThickness="1" CornerRadius="9" Padding="9,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <RadioButton x:Name="RunningNav" Grid.Row="0" GroupName="Sessions" Tag="running"
                                         IsChecked="True" Style="{StaticResource NavRadio}" Checked="OnFilterTabChecked">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="运行中" FontSize="13" FontWeight="SemiBold" />
                                    <Border Grid.Column="1" Background="#FF34413E" CornerRadius="8" Padding="6,1">
                                        <TextBlock Text="{Binding RunningCountText}" FontSize="10" />
                                    </Border>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="RecentNav" Grid.Row="1" GroupName="Sessions" Tag="recent" Style="{StaticResource NavRadio}"
                                         Checked="OnFilterTabChecked" Content="最近会话" />
                            <RadioButton x:Name="AllNav" Grid.Row="2" GroupName="Sessions" Tag="all" Style="{StaticResource NavRadio}"
                                         Checked="OnFilterTabChecked">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="全部" FontSize="13" />
                                    <TextBlock Grid.Column="1" Text="{Binding PrimarySessionCountText}" Foreground="{StaticResource HudSubtle}" FontSize="11" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="InternalNav" Grid.Row="3" GroupName="Sessions" Tag="internal" Style="{StaticResource NavRadio}"
                                         Checked="OnFilterTabChecked">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="未归属历史" FontSize="12" Foreground="{StaticResource HudMuted}"
                                               ToolTip="旧记录中父会话已不可用或没有父会话元数据的子任务" />
                                    <TextBlock Grid.Column="1" Text="{Binding OrphanTaskCountText}" Foreground="{StaticResource HudSubtle}" FontSize="11" />
                                </Grid>
                            </RadioButton>
                            <Border Grid.Row="5" Background="#FF263234" />
                            <Border Grid.Row="7" Grid.RowSpan="2" Background="#FF141C1E" BorderBrush="#FF263234"
                                    BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="本周期摘要" Foreground="{StaticResource HudMuted}" FontSize="11" />
                                    <TextBlock Text="{Binding CycleCompactText}" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="23" FontWeight="SemiBold" Margin="0,9,0,0" />
                                    <TextBlock Text="全部会话 · raw tokens" Foreground="{StaticResource HudSubtle}" FontSize="11" />
                                    <Border Background="#FF263234" Height="1" Margin="0,13,0,11" />
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="运行中会话" Foreground="{StaticResource HudMuted}" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="{Binding RunningCycleCompactText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                                    </Grid>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="主会话总数" Foreground="{StaticResource HudMuted}" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="{Binding PrimarySessionCountText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                                    </Grid>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="APP" Foreground="{StaticResource HudMuted}" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="{Binding AppSessionCountText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                                    </Grid>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="CLI" Foreground="{StaticResource HudMuted}" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="{Binding CliSessionCountText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="已识别子任务" Foreground="{StaticResource HudMuted}" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="{Binding InternalTaskCountText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                                    </Grid>
                                    <TextBlock Text="子任务归并显示；本机总量仍只计一次" Foreground="{StaticResource HudSubtle}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="DataStatusButton" Grid.Row="9" Style="{StaticResource HudButton}"
                                    Content="数据状态与隐私" Click="OnToggleDiagnostics" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150" />
                            <RowDefinition Height="46" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Background="#FF141C1E" BorderBrush="#FF2A383A" BorderThickness="1" CornerRadius="9" Padding="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.25*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="剩余额度" Style="{StaticResource MetricLabel}" />
                                    <TextBlock x:Name="ExpandedRemainingText" Text="{Binding RemainingText}"
                                               Foreground="{StaticResource HudMint}" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="48" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="已用 " Foreground="{StaticResource HudMuted}" FontSize="11" />
                                        <TextBlock Text="{Binding UsedText}" Foreground="{StaticResource HudMuted}" FontSize="11" />
                                        <TextBlock Text=" · " Foreground="{StaticResource HudSubtle}" FontSize="11" />
                                        <TextBlock x:Name="ThresholdStateText" Text="{Binding QuotaStateText}"
                                                   Foreground="{StaticResource HudMint}" FontSize="11" FontWeight="SemiBold"
                                                   ToolTip="{Binding QuotaStateDetailText}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" BorderBrush="#FF2B383A" BorderThickness="1,0,0,0" Padding="18,0,0,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="重置倒计时" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding CountdownText}" Style="{StaticResource MetricValue}" FontSize="20" Margin="0,13,0,0" />
                                        <TextBlock Text="{Binding ResetTimeText}" Foreground="{StaticResource HudSubtle}" FontSize="10.5" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="#FF2B383A" BorderThickness="1,0,0,0" Padding="18,0,0,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="运行中" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding RunningCountText}" Style="{StaticResource MetricValue}" Margin="0,13,0,0" />
                                        <TextBlock Text="个会话" Foreground="{StaticResource HudSubtle}" FontSize="10.5" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" BorderBrush="#FF2B383A" BorderThickness="1,0,0,0" Padding="18,0,0,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="本机本周期" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding CycleCompactText}" Style="{StaticResource MetricValue}" Margin="0,13,0,0" />
                                        <TextBlock Text="raw tokens" Foreground="{StaticResource HudSubtle}" FontSize="10.5" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="10,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="会话" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding VisibleSessionCountText}" Foreground="{StaticResource HudSubtle}"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox x:Name="SortComboBox" Grid.Column="2" Width="156" SelectionChanged="OnSortChanged" SelectedIndex="0"
                                      ToolTip="置顶会话始终排在第一位；其余会话按所选规则排序">
                                <ComboBoxItem Content="置顶优先 · 按活动" Tag="activity" />
                                <ComboBoxItem Content="置顶优先 · 按 token" Tag="token" />
                            </ComboBox>
                        </Grid>

                        <Border Grid.Row="2" Background="#FF0E1517" BorderBrush="#FF2A383A" BorderThickness="1" CornerRadius="9">
                            <DataGrid x:Name="SessionGrid" ItemsSource="{Binding Rows}" SelectedIndex="0"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="状态" Width="88">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource HudSubtle}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EffectiveIsRunning}" Value="True"><Setter Property="Fill" Value="{StaticResource HudMint}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="未知"><Setter Property="Fill" Value="#FFFFC857" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Status}" FontSize="11" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="对话 / ID" Width="2.35*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Border Width="{Binding HierarchyIndent}" />
                                                    <Button Grid.Column="1" Width="22" Height="28" Margin="0,0,3,0"
                                                            Click="OnToggleSessionChildren" Background="Transparent" BorderThickness="0"
                                                            Foreground="{StaticResource HudMuted}" Cursor="Hand" ToolTip="展开或收起所属子任务">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasChildren}" Value="False"><Setter Property="Visibility" Value="Hidden" /></DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF222D2F" /></Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock Text="{Binding ExpansionGlyph}" FontSize="18" />
                                                    </Button>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border BorderBrush="#FF4B595B" BorderThickness="1" CornerRadius="4" Padding="5,1"
                                                                    Margin="0,0,7,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SourceLabel}" Foreground="{StaticResource HudMuted}" FontSize="11" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding ShortId}" Foreground="{StaticResource HudSubtle}"
                                                                   FontFamily="Cascadia Mono, Consolas" FontSize="10" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="&#xE718;" FontFamily="{StaticResource HudIconFont}"
                                                               Foreground="{StaticResource HudMint}" FontSize="12"
                                                               ToolTip="此会话已置顶；无论排序规则都排在第一位" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="项目" Binding="{Binding Project}" Width="1.05*" />
                                    <DataGridTextColumn Header="模型" Binding="{Binding Model}" Width="1*" />
                                    <DataGridTemplateColumn Header="工作合计 (raw)" Width="1.35*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding WorkTotalText}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" />
                                                    <TextBlock Text="{Binding WorkBreakdownText}" Foreground="{StaticResource HudSubtle}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <Border x:Name="DetailPanel" Grid.Column="4" Background="#FF0E1517" BorderBrush="#FF2A383A" BorderThickness="1" CornerRadius="9"
                            DataContext="{Binding SelectedItem, ElementName=SessionGrid}" Padding="14">
                        <Grid x:Name="DetailContentGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="0" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ThreadId}" Foreground="{StaticResource HudSubtle}"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button x:Name="SessionPinButton" Grid.Column="1" Width="72" Height="34"
                                        Click="OnTogglePin">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource HudButton}">
                                            <Setter Property="Content" Value="置顶会话" />
                                            <Setter Property="ToolTip" Value="置顶此会话；置顶后始终排在第一位" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Content" Value="已置顶" />
                                                    <Setter Property="Foreground" Value="{StaticResource HudMint}" />
                                                    <Setter Property="Background" Value="{StaticResource HudSelected}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource HudMint}" />
                                                    <Setter Property="ToolTip" Value="取消会话置顶" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                            <Border Grid.Row="2" Background="#FF2A383A" />
                            <StackPanel Grid.Row="4">
                                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="项目" Foreground="{StaticResource HudMuted}" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding Project}" FontSize="12" TextTrimming="CharacterEllipsis" /></Grid>
                                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="来源" Foreground="{StaticResource HudMuted}" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding SourceLabel}" FontSize="12" /></Grid>
                                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="归属" Foreground="{StaticResource HudMuted}" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding ParentSummaryText}" FontSize="12" TextTrimming="CharacterEllipsis" /></Grid>
